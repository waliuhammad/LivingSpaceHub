# Copy to .env.deploy and fill in, then run `npm run deploy`.
# hPanel → Files → FTP Accounts
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Explicit FTPS (encrypted). Set to false only if your host rejects TLS.
FTP_SECURE=true
# Folder on the server that serves your domain
FTP_REMOTE_DIR=/public_html
