# Living Space Hub API — only the four endpoint scripts are reachable.
Options -Indexes

<FilesMatch "^_">
  Require all denied
</FilesMatch>

# Pass the Authorization header through to PHP (needed for staff-only endpoints)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
