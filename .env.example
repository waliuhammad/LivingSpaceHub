# Copy this file to .env and fill in the values, then run `npm run build`.
# Vite bakes these into the build, so rebuild after changing them.

# Firebase → Project settings → General → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary → Dashboard (cloud name) and Settings → Upload → Upload presets (unsigned preset name)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
