{
  "name": "living-space-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "firebase:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "make-admin": "node scripts/make-admin.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-living-space-hub \"node --test tests/firestore.rules.test.mjs\"",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "basic-ftp": "^6.2.1",
    "firebase-admin": "^14.4.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
